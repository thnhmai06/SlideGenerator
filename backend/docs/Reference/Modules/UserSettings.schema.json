{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thnhmai06/SlideGenerator/blob/main/backend/docs/Reference/Modules/UserSettings.schema.json",
  "title": "SlideGenerator user settings (UserSettings.json)",
  "description": "Persisted by SlideGenerator.Settings.Mutable.SettingManager at %LOCALAPPDATA%/SlideGenerator/Data/UserSettings.json.",
  "type": "object",
  "properties": {
    "Application": { "$ref": "#/$defs/Setting" }
  },
  "required": ["Application"],
  "additionalProperties": false,
  "$defs": {
    "Setting": {
      "type": "object",
      "properties": {
        "Network": { "$ref": "#/$defs/NetworkSetting" },
        "Performance": { "$ref": "#/$defs/PerformanceSetting" }
      },
      "additionalProperties": false
    },
    "NetworkSetting": {
      "type": "object",
      "properties": {
        "Proxy": { "$ref": "#/$defs/Proxy" },
        "Retry": { "$ref": "#/$defs/RetrySetting" },
        "MaxDownloadBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "default": 52428800,
          "description": "Max bytes allowed per downloaded file. 0 = unlimited."
        }
      },
      "additionalProperties": false
    },
    "Proxy": {
      "type": "object",
      "properties": {
        "UseProxy": { "type": "boolean", "default": false },
        "Domain": { "type": "string", "default": "" },
        "Password": { "type": "string", "default": "" },
        "ProxyAddress": {
          "type": "string",
          "default": "",
          "description": "e.g. http://proxy:8080"
        },
        "Username": { "type": "string", "default": "" }
      },
      "additionalProperties": false
    },
    "RetrySetting": {
      "type": "object",
      "properties": {
        "MaxRetries": { "type": "integer", "minimum": 0, "default": 3 },
        "Timeout": { "type": "integer", "minimum": 0, "default": 30, "description": "Seconds." },
        "MaxRetryDelay": { "type": "integer", "minimum": 0, "default": 16, "description": "Seconds." }
      },
      "additionalProperties": false
    },
    "PerformanceSetting": {
      "type": "object",
      "properties": {
        "MaxConcurrentJobs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "default": 5
        }
      },
      "additionalProperties": false
    }
  }
}
