<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Remove="StyleCop.Analyzers"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1"/>
        <PackageReference Include="xunit.v3" Version="3.2.2"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11"/>
        <PackageReference Include="NSubstitute" Version="6.2.0"/>
        <PackageReference Include="FluentAssertions" Version="8.10.0"/>
        <PackageReference Include="Serilog" Version="4.4.0"/>
        <PackageReference Remove="coverlet.collector" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/SlideGenerator.Generator/SlideGenerator.Generator.csproj"/>
        <ProjectReference Include="../../src/SlideGenerator.Utilities/SlideGenerator.Utilities.csproj"/>
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11"/>
        <ProjectReference Include="../../src/SlideGenerator.Logging/SlideGenerator.Logging.csproj"/>
        <ProjectReference Include="../../src/SlideGenerator.Document/SlideGenerator.Document.csproj"/>
        <ProjectReference Include="..\..\src\SlideGenerator.Cloud\SlideGenerator.Cloud.csproj"/>
        <ProjectReference Include="../../src/SlideGenerator.Settings/SlideGenerator.Settings.csproj"/>
        <ProjectReference Include="../../src/SlideGenerator.Image/SlideGenerator.Image.csproj"/>
        <ProjectReference Include="..\..\src\SlideGenerator.Summarizer\SlideGenerator.Summarizer.csproj"/>
        <ProjectReference Include="../../src/SlideGenerator.Recipe/SlideGenerator.Recipe.csproj"/>
        <ProjectReference Include="../../src/SlideGenerator.Jobs/SlideGenerator.Jobs.csproj"/>
    </ItemGroup>

    <!-- Needed for the SlideGenerationWorkload integration test: Document's SfWorkbookOpener/SfPresentationOpener
         load Syncfusion at runtime, and Microsoft.Extensions.Http.IHttpClientFactory is referenced by the
         workload's constructor. Neither package flows transitively through a ProjectReference (see
         CLAUDE.md's NuGet-transitivity pitfall — Directory.Build.props sets PrivateAssets="all" on all
         ProjectReference items), so both must be declared explicitly here. -->
    <ItemGroup>
        <PackageReference Include="Syncfusion.XlsIO.NET" Version="34.2.3" />
        <PackageReference Include="Syncfusion.Presentation.NET" Version="34.2.3" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\fixtures\data\Template.pptx">
            <Link>fixtures\data\Template.pptx</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="..\fixtures\data\Data.xlsx">
            <Link>fixtures\data\Data.xlsx</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <!-- The faces fixture is not committed; it is downloaded into tests/fixtures/faces by the Image
             tests' FaceDatasetFixture. Make the copy conditional so a build that runs before any download
             (e.g. CI) doesn't fail with MSB3030 — the integration test skips when the file is absent. -->
        <None Include="..\fixtures\faces\single\f_0.jpg" Condition="Exists('..\fixtures\faces\single\f_0.jpg')">
            <Link>fixtures\faces\single\f_0.jpg</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
</Project>
