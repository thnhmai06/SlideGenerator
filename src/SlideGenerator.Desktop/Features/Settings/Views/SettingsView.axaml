<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SlideGenerator.Desktop.Features.Settings.ViewModels"
             xmlns:loc="clr-namespace:SlideGenerator.Desktop.Services.Localization"
             xmlns:conv="clr-namespace:SlideGenerator.Desktop.Converters"
             xmlns:settings="clr-namespace:SlideGenerator.Settings.Mutable;assembly=SlideGenerator.Settings"
             x:Class="SlideGenerator.Desktop.Features.Settings.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <ScrollViewer>
        <StackPanel Margin="{StaticResource PaddingPanel}" Spacing="{StaticResource Space4}" MaxWidth="640">

            <!-- Giao diện -->
            <StackPanel Spacing="{StaticResource Space2}">
                <TextBlock Classes="h1" Text="{loc:Tr settings.appearance}"/>

                <TextBlock Classes="body" Text="{loc:Tr settings.theme}"/>
                <!-- Card-style options (plan §5.6: "theme = 3 lựa chọn dạng card nhỏ") rather than bare radio
                     text — still plain RadioButtons underneath for state/keyboard behavior, just re-templated
                     as a bordered card with an icon. A live mini light/dark/system preview render inside each
                     card (the plan's stretch idea) is not built here — plain icon + label only. -->
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
                    <ToggleButton Classes="theme-option"
                                  IsChecked="{Binding Theme, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static settings:ThemeMode.System}}">
                        <StackPanel Spacing="{StaticResource Space1}" HorizontalAlignment="Center">
                            <TextBlock Text="&#9703;" HorizontalAlignment="Center" FontSize="{StaticResource FontSizeLg}"/>
                            <TextBlock Text="{loc:Tr settings.theme.system}"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Classes="theme-option"
                                  IsChecked="{Binding Theme, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static settings:ThemeMode.Light}}">
                        <StackPanel Spacing="{StaticResource Space1}" HorizontalAlignment="Center">
                            <TextBlock Text="&#9728;" HorizontalAlignment="Center" FontSize="{StaticResource FontSizeLg}"/>
                            <TextBlock Text="{loc:Tr settings.theme.light}"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Classes="theme-option"
                                  IsChecked="{Binding Theme, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static settings:ThemeMode.Dark}}">
                        <StackPanel Spacing="{StaticResource Space1}" HorizontalAlignment="Center">
                            <TextBlock Text="&#9790;" HorizontalAlignment="Center" FontSize="{StaticResource FontSizeLg}"/>
                            <TextBlock Text="{loc:Tr settings.theme.dark}"/>
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>

                <TextBlock Classes="body" Text="{loc:Tr settings.language}"/>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space3}">
                    <RadioButton GroupName="Language" Content="{loc:Tr settings.language.vietnamese}"
                                 IsChecked="{Binding Language, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter=vi}"/>
                    <RadioButton GroupName="Language" Content="{loc:Tr settings.language.english}"
                                 IsChecked="{Binding Language, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter=en}"/>
                </StackPanel>

                <CheckBox Content="{loc:Tr settings.reducedMotion}" IsChecked="{Binding ReducedMotion}"/>
            </StackPanel>

            <Border Classes="hairline-row"/>

            <!-- Hiệu năng -->
            <StackPanel Spacing="{StaticResource Space2}">
                <TextBlock Classes="h1" Text="{loc:Tr settings.performance}"/>

                <TextBlock Classes="body" Text="{loc:Tr settings.maxConcurrentJobs}"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space2}">
                    <Slider Grid.Column="0" Minimum="1" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding MaxConcurrentJobs}"/>
                    <TextBlock Grid.Column="1" Classes="mono" Text="{Binding MaxConcurrentJobs}" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Classes="muted" FontSize="{StaticResource FontSizeSm}" TextWrapping="Wrap"
                           Text="{loc:Tr settings.maxConcurrentJobsHint}"/>
                <Button Content="{loc:Tr settings.resetDefaults}" Command="{Binding ResetPerformanceCommand}"/>
            </StackPanel>

            <Border Classes="hairline-row"/>

            <!-- Mạng -->
            <StackPanel Spacing="{StaticResource Space2}">
                <TextBlock Classes="h1" Text="{loc:Tr settings.network}"/>

                <TextBlock Classes="h2" Text="{loc:Tr settings.proxy}"/>
                <CheckBox Content="{loc:Tr settings.proxy.enable}" IsChecked="{Binding UseProxy}"/>
                <StackPanel Spacing="{StaticResource Space2}" IsVisible="{Binding UseProxy}">
                    <TextBlock Classes="muted" Text="{loc:Tr settings.proxy.address}"/>
                    <TextBox Text="{Binding ProxyAddress}"/>
                    <TextBlock Classes="muted" Text="{loc:Tr settings.proxy.username}"/>
                    <TextBox Text="{Binding ProxyUsername}"/>
                    <TextBlock Classes="muted" Text="{loc:Tr settings.proxy.password}"/>
                    <TextBox Text="{Binding ProxyPassword}" PasswordChar="*"/>
                    <TextBlock Classes="muted" Text="{loc:Tr settings.proxy.domain}"/>
                    <TextBox Text="{Binding ProxyDomain}"/>
                </StackPanel>

                <TextBlock Classes="h2" Text="{loc:Tr settings.retry}"/>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource Space2}">
                    <StackPanel Grid.Column="0" Spacing="{StaticResource Space1}">
                        <TextBlock Classes="muted" Text="{loc:Tr settings.retry.maxAttempts}"/>
                        <NumericUpDown Value="{Binding MaxRetries}" Minimum="0" FormatString="0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="{StaticResource Space1}">
                        <TextBlock Classes="muted" Text="{loc:Tr settings.retry.timeoutSeconds}"/>
                        <NumericUpDown Value="{Binding RetryTimeoutSeconds}" Minimum="0" FormatString="0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="{StaticResource Space1}">
                        <TextBlock Classes="muted" Text="{loc:Tr settings.retry.maxBackoffSeconds}"/>
                        <NumericUpDown Value="{Binding MaxRetryDelaySeconds}" Minimum="0" FormatString="0"/>
                    </StackPanel>
                </Grid>

                <TextBlock Classes="muted" Text="{loc:Tr settings.network.maxDownloadMb}"/>
                <NumericUpDown Value="{Binding MaxDownloadMegabytes}" Minimum="0" FormatString="0"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
