<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SlideGenerator.Desktop.Features.RecipeEditor.ViewModels"
             xmlns:views="clr-namespace:SlideGenerator.Desktop.Features.RecipeEditor.Views"
             xmlns:models="clr-namespace:SlideGenerator.Desktop.Features.RecipeEditor.Models"
             xmlns:conv="clr-namespace:SlideGenerator.Desktop.Converters"
             xmlns:loc="clr-namespace:SlideGenerator.Desktop.Services.Localization"
             x:Class="SlideGenerator.Desktop.Features.RecipeEditor.Views.RecipeEditorView"
             x:DataType="vm:RecipeEditorViewModel">
    <Grid>
    <!-- Advanced (plan §5.2.b) -->
    <Grid RowDefinitions="Auto,*" IsVisible="{Binding !IsGuided}">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="{StaticResource PaddingPanel}">
            <TextBlock Grid.Column="0" Classes="muted" FontSize="{StaticResource FontSizeSm}" VerticalAlignment="Center"
                       Text="{Binding CombinedSummary, Converter={x:Static conv:BindingSummaryConverter.Instance}}"/>
            <Button Grid.Column="1" Content="{loc:Tr recipeEditor.addMapping}" Command="{Binding AddMappingCommand}"/>
        </Grid>

        <Grid Grid.Row="1">
            <!-- No mapping to show yet (brand-new recipe, or a mapping still loading) -->
            <TextBlock Classes="muted body" Text="{loc:Tr recipeEditor.noMappings}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding SelectedSession, Converter={x:Static ObjectConverters.IsNull}}"/>

            <Grid ColumnDefinitions="Auto,2*,1*"
                  IsVisible="{Binding SelectedSession, Converter={x:Static ObjectConverters.IsNotNull}}">
            <!-- Mapping navigator: only meaningful once there's more than one mapping to pick between -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0"
                    IsVisible="{Binding ShowMappingNavigator}" Width="180">
                <ListBox x:Name="NavigatorList" ItemsSource="{Binding Sessions}"
                         SelectedItem="{Binding SelectedSession, Mode=OneWay}"
                         SelectionChanged="OnNavigatorSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:MappingEditSession">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                <TextBlock Grid.Column="0" Classes="body" Text="{Binding Label}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="{loc:Tr recipeEditor.moveUp}" Click="OnMoveUpClick"/>
                                <Button Grid.Column="2" Content="{loc:Tr recipeEditor.moveDown}" Click="OnMoveDownClick"/>
                                <Button Grid.Column="3" Content="{loc:Tr recipeEditor.remove}" Click="OnRemoveMappingClick"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Canvas -->
            <views:SlideCanvasView Grid.Column="1" DataContext="{Binding Canvas}"/>

            <!-- Text bindings + worksheet sources + selected-shape inspector -->
            <ScrollViewer Grid.Column="2">
                <StackPanel Margin="{StaticResource PaddingPanel}" Spacing="{StaticResource Space3}">
                    <views:TextBindingsView DataContext="{Binding TextBindings}"/>
                    <views:WorksheetSourcesView DataContext="{Binding Sources}"/>

                    <!-- Inspector: ROI try-order + fallback image for the shape selected on the canvas -->
                    <Border Classes="hairline-row" IsVisible="{Binding Canvas.SelectedOverlay, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel x:Name="InspectorPanel" Spacing="{StaticResource Space2}"
                                    DataContext="{Binding Canvas.SelectedOverlay}" x:DataType="vm:ShapeOverlayViewModel">
                            <TextBlock Classes="label" Text="{loc:Tr recipeEditor.inspector.title}"/>
                            <TextBlock Classes="muted" Text="{Binding Shape.Shape.ShapeName}"/>

                            <TextBlock Classes="body" Text="{loc:Tr recipeEditor.inspector.roiOrder}"/>
                            <ItemsControl ItemsSource="{Binding RoiOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                            <TextBlock Grid.Column="0" Classes="mono" VerticalAlignment="Center">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{x:Static conv:RoiDescriptionConverter.Instance}">
                                                        <Binding/>
                                                        <Binding Path="Revision" Source="{x:Static loc:LocalizationService.Instance}"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <Button Grid.Column="1" Content="{loc:Tr recipeEditor.moveUp}" Click="OnRoiMoveUpClick"/>
                                            <Button Grid.Column="2" Content="{loc:Tr recipeEditor.moveDown}" Click="OnRoiMoveDownClick"/>
                                            <Button Grid.Column="3" Content="{loc:Tr recipeEditor.remove}" Click="OnRoiRemoveClick"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Classes="body" Text="{Binding FallbackImagePath}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="{loc:Tr recipeEditor.pickFallbackImage}" Click="OnPickFallbackImageClick"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            </Grid>

            <Border IsVisible="{Binding IsLoading}" Background="{DynamicResource SurfaceBackgroundBrush}" Opacity="0.6">
                <ProgressBar IsIndeterminate="True" Width="120" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Grid>

    <!-- Guided (plan §5.2.a) — same panels as Advanced, one step's worth shown at a time. No internal
         vocabulary ("Mapping"/"Instruction"/"Source") appears here, only step titles. -->
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="{StaticResource PaddingPanel}" RowSpacing="{StaticResource Space3}"
          IsVisible="{Binding IsGuided}">
        <!-- Stepper dots (plan §5.2.a: "4 chấm + nhãn, active accent") — the step number that used to be
             baked into GuidedStepTitle's text now lives here instead. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="{StaticResource Space1}" HorizontalAlignment="Center">
            <Border Classes="step-dot" Classes.active="{Binding GuidedStep, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static models:GuidedStep.Template}}"/>
            <Border Classes="step-dot" Classes.active="{Binding GuidedStep, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static models:GuidedStep.Data}}"/>
            <Border Classes="step-dot" Classes.active="{Binding GuidedStep, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static models:GuidedStep.Binding}}"/>
            <Border Classes="step-dot" Classes.active="{Binding GuidedStep, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static models:GuidedStep.Review}}"/>
        </StackPanel>
        <TextBlock Grid.Row="1" Classes="h1" Text="{Binding GuidedStepTitle}" HorizontalAlignment="Center"/>

        <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="{StaticResource Space3}">
                <!-- Template -->
                <StackPanel Spacing="{StaticResource Space2}"
                            IsVisible="{Binding GuidedStep, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static models:GuidedStep.Template}}">
                    <Button Content="{loc:Tr recipeEditor.guided.pickTemplate}" Command="{Binding AddMappingCommand}" IsVisible="{Binding !HasTemplate}"/>
                    <Border IsVisible="{Binding HasTemplate}">
                        <views:SlideCanvasView Height="320" DataContext="{Binding Canvas}"/>
                    </Border>
                </StackPanel>

                <!-- Data -->
                <StackPanel IsVisible="{Binding GuidedStep, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static models:GuidedStep.Data}}">
                    <views:WorksheetSourcesView DataContext="{Binding Sources}"/>
                </StackPanel>

                <!-- Match — always split into "Text"/"Images" sub-groups, never one merged list -->
                <StackPanel Spacing="{StaticResource Space3}"
                            IsVisible="{Binding GuidedStep, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static models:GuidedStep.Binding}}">
                    <TextBlock Classes="label" Text="{loc:Tr recipeEditor.section.text}"/>
                    <views:TextBindingsView DataContext="{Binding TextBindings}"/>
                    <TextBlock Classes="label" Text="{loc:Tr recipeEditor.section.images}"/>
                    <views:SlideCanvasView Height="320" DataContext="{Binding Canvas}"/>
                </StackPanel>

                <!-- Review -->
                <StackPanel Spacing="{StaticResource Space3}"
                            IsVisible="{Binding GuidedStep, Converter={x:Static conv:EnumEqualsConverter.Instance}, ConverterParameter={x:Static models:GuidedStep.Review}}">
                    <TextBlock Classes="body">
                        <Run Text="{loc:Tr recipeEditor.guided.willCreatePrefix}"/><Run Text="{Binding GuidedFileCount}"/><Run Text="{loc:Tr recipeEditor.guided.willCreateSuffix}"/>
                    </TextBlock>
                    <TextBlock Classes="muted" FontSize="{StaticResource FontSizeSm}"
                               Text="{Binding CombinedSummary, Converter={x:Static conv:BindingSummaryConverter.Instance}}"/>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
                        <Button Classes="Tertiary" Content="{loc:Tr recipeEditor.guided.save}" Command="{Binding SaveCommand}"/>
                        <Button Classes="Primary" Content="{loc:Tr recipeEditor.guided.saveAndRun}" Command="{Binding SaveAndRunCommand}"/>
                    </StackPanel>
                    <Button Classes="Tertiary" Content="{loc:Tr recipeEditor.guided.switchToAdvanced}"
                            Command="{Binding SwitchToAdvancedCommand}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto">
            <Button Grid.Column="0" Content="{loc:Tr recipeEditor.guided.back}" Command="{Binding PreviousGuidedStepCommand}"/>
            <Button Grid.Column="2" Classes="Primary" Content="{loc:Tr recipeEditor.guided.next}" Command="{Binding NextGuidedStepCommand}"
                    IsVisible="{Binding GuidedStep, Converter={x:Static conv:EnumNotEqualsConverter.Instance}, ConverterParameter={x:Static models:GuidedStep.Review}}"/>
        </Grid>
    </Grid>
    </Grid>
</UserControl>
