<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SlideGenerator.Desktop.Features.RecipeEditor.ViewModels"
        xmlns:models="clr-namespace:SlideGenerator.Desktop.Features.RecipeEditor.Models"
        x:Class="SlideGenerator.Desktop.Features.RecipeEditor.Views.TemplatePickerView"
        x:DataType="vm:TemplatePickerViewModel"
        Title="Chọn slide mẫu"
        Width="560" Height="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}">
    <Grid RowDefinitions="Auto,*,Auto" Margin="{StaticResource PaddingPanel}" RowSpacing="{StaticResource Space3}">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space2}">
            <TextBox Grid.Column="0" Text="{Binding PresentationPath}" IsReadOnly="True"
                     PlaceholderText="Chưa chọn presentation"/>
            <Button Grid.Column="1" Content="Chọn presentation..." Command="{Binding PickPresentationCommand}"/>
        </Grid>

        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <TextBlock Classes="muted body" Text="Đang tải..." HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding IsLoading}"/>
                <TextBlock Classes="body" Foreground="{DynamicResource DangerBrush}" Text="{Binding ErrorMessage}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="16"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                <ScrollViewer IsVisible="{Binding !IsLoading}">
                    <ItemsControl ItemsSource="{Binding Slides}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:TemplateSlideRow">
                                <Border Classes="hairline-row" Width="160" Margin="4" PointerPressed="OnSlidePointerPressed">
                                    <StackPanel Spacing="{StaticResource Space1}">
                                        <Image Source="{Binding Preview}" Stretch="Uniform" Height="90"/>
                                        <TextBlock Classes="muted" HorizontalAlignment="Center">
                                            <Run Text="Slide "/>
                                            <Run Text="{Binding Slide.Slide.SlideIndex}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{StaticResource Space2}">
            <Button Content="Huỷ" Command="{Binding CancelCommand}"/>
            <Button Content="Chọn" Command="{Binding ConfirmCommand}"
                    Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource TextOnAccentBrush}"/>
        </StackPanel>
    </Grid>
</Window>
