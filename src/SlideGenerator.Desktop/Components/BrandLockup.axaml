<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SlideGenerator.Desktop.Components.BrandLockup">
    <UserControl.Styles>
        <!-- Transitions, not Style.Animations/KeyFrame — Avalonia has no built-in Animator for RenderTransform
             inside a KeyFrame ("No animator registered for the property RenderTransform"), but Transitions
             support it natively via TransformOperationsTransition (same mechanism Controls.axaml already uses
             for button press feedback). The entrance plays once per Play() call, driven by toggling the
             "revealed" class from code-behind rather than by attaching/detaching a pseudo-class. Reduced
             motion (Setting.Appearance.ReducedMotion) sets App-level MotionBrand to 0 via
             ThemeService.ApplyReducedMotion — the transition then completes instantly, landing directly on
             its end-state with no visible motion, and Play()'s own before/after holds also collapse to zero
             (see its own remarks). -->
        <Style Selector="Image.lockup-mark">
            <Setter Property="RenderTransform" Value="none"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource MotionBrand}"
                                                    Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Image.lockup-mark.revealed">
            <Setter Property="RenderTransform" Value="translateX(-64px)"/>
        </Style>

        <Style Selector="Image.lockup-word">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform" Value="translateX(-16px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="{DynamicResource MotionBrand}"
                                       Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource MotionBrand}"
                                                    Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Image.lockup-word.revealed">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="RenderTransform" Value="none"/>
        </Style>
    </UserControl.Styles>

    <!-- Mark drawn after (on top of) wordmark, so it visually "reveals" the wordmark as it slides left. -->
    <Panel Width="260" Height="56">
        <Image x:Name="WordImage" Classes="lockup-word"
               Source="avares://SlideGenerator.Desktop/Assets/Brand/app-name.png"
               Height="34" HorizontalAlignment="Left" Margin="72,0,0,0" RenderTransformOrigin="0,0.5"/>
        <Image x:Name="MarkImage" Classes="lockup-mark"
               Source="avares://SlideGenerator.Desktop/Assets/Brand/app-icon.png"
               Height="56" HorizontalAlignment="Left" RenderTransformOrigin="0,0.5"/>
    </Panel>
</UserControl>
