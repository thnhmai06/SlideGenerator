<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:SlideGenerator.Desktop.Components"
             x:Class="SlideGenerator.Desktop.Shell.SplashView">
    <Grid Background="{DynamicResource SurfaceBackgroundBrush}">
        <components:BrandLockup x:Name="Lockup" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
