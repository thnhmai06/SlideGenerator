<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:SlideGenerator.Desktop.Shell"
             x:Class="SlideGenerator.Desktop.Shell.ShellView"
             x:DataType="shell:ShellViewModel">
    <Grid RowDefinitions="48,*" Background="{DynamicResource SurfaceBackgroundBrush}">
        <shell:TitleToolbar Grid.Row="0"/>

        <!-- Page content — PageTransition assigned in code-behind, see its comment. -->
        <TransitioningContentControl Grid.Row="1" x:Name="PageHost" Content="{Binding CurrentPage}"/>
    </Grid>
</UserControl>
