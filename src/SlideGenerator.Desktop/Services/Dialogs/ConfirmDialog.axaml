<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SlideGenerator.Desktop.Services.Dialogs.ConfirmDialog"
        x:Name="Root"
        Width="380" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}">
    <StackPanel Margin="{StaticResource PaddingPanel}" Spacing="{StaticResource Space4}">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
            <TextBlock Text="&#9888;" Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding #Root.IsDanger}"/>
            <TextBlock Classes="body" Text="{Binding #Root.Message}" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{StaticResource Space2}">
            <Button Content="{Binding #Root.CancelLabel}" Click="OnCancel" HotKey="Escape"/>
            <Button Content="{Binding #Root.ConfirmLabel}" Click="OnConfirm"
                    Classes.Primary="{Binding !#Root.IsDanger}" Classes.Danger="{Binding #Root.IsDanger}"/>
        </StackPanel>
    </StackPanel>
</Window>
